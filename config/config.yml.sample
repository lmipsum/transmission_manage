# Example configuration. These are NOT defaults: review every value before use.
# Section and key names follow qbit_manage where Transmission allows it; unknown keys are ignored with a warning.

commands:
  # Commands set here OVERRIDE the command line, as in qbit_manage. Remove the section to use CLI flags only.
  dry_run: True # Log what would change, change nothing.
  recheck: False
  tag_update: False
  rem_unregistered: False
  tag_tracker_error: False
  rem_orphaned: False
  tag_nohardlinks: False
  share_limits: False
  skip_cleanup: False

transmission:
  host: "localhost:9091"
  rpc_path: "/transmission/rpc"
  # Pass environment variables to the config via the !ENV tag.
  user: !ENV TRANSMISSION_USER
  pass: !ENV TRANSMISSION_PASS
  ssl: False
  protocol: auto # auto | jsonrpc (Transmission 4.1+) | legacy
  timeout: 30 # Seconds per RPC call.
  retries: 2 # Retries on connection errors.

settings:
  tracker_error_tag: issue # Label for torrents without a working tracker.
  nohardlinks_tag: noHL # Label for torrents without hardlinks outside the root dir.
  stalled_tag: stalledDL # Label for torrents stalled while downloading (tag_update).
  tag_stalled_torrents: True # Label stalled downloads with stalled_tag when running tag_update.
  private_tag: null # Label for private torrents (null to disable).
  tag_nohardlinks_filter_completed: True # Only check completed torrents.
  rem_unregistered_filter_completed: False # Only remove completed torrents.
  rem_unregistered_ignore_list: # Tracker messages containing any of these are never treated as unregistered.
    - example placeholder words
  rem_unregistered_grace_minutes: 10 # Skip torrents added less than this many minutes ago.
  rem_unregistered_max_torrents: 10 # Max removals per tracker per run.
  share_limits_tag: ~share_limit # Prefix of the label naming each torrent's share limit group and priority.
  share_limits_min_seeding_time_tag: MinSeedTimeNotReached # Label while min_seeding_time is not reached.
  share_limits_min_num_seeds_tag: MinSeedsNotMet # Label while min_num_seeds is not met.
  share_limits_last_active_tag: LastActiveLimitNotReached # Label while min_last_active is not reached.
  share_limits_filter_completed: True # Only apply share limits to completed torrents.
  # Turn off Transmission's session-wide ratio and idle limits while share_limits runs, so the groups decide.
  disable_qbt_default_share_limits: True

directory:
  root_dir: "/path/to/torrents/" # Download root used for orphaned files and noHL.
  remote_dir: null # Host path of root_dir if Transmission runs in a container and this tool does not.
  torrents_dir: "/path/to/transmission/torrents" # Transmission's .torrent store.
  orphaned_dir: "/path/to/torrents/.orphaned" # Orphaned files are moved here before being purged.

tracker:
  # <URL keyword>: keyword found in the announce URL; several keywords can be joined with '|'.
  #   tag: a label or a list of labels.
  tracker-one.example.org:
    tag: TrackerOne
  tracker-two.example.net|tracker-two-backup.example.net:
    tag: [TrackerTwo, private]
  # The special key 'other' tags every torrent whose tracker matched none of the keywords above.
  other:
    tag: other

nohardlinks:
  # Label torrents whose files are not hardlinked outside root_dir (e.g. not imported into a media library).
  # Keys are Transmission labels (qbit_manage uses categories; Transmission has none). Needs directory.root_dir.
  # <OPTIONAL> global_options: defaults for every label. exclude_tags are merged; ignore_root_dir is overridden per label.
  global_options:
    exclude_tags:
      - keep-seeding
    ignore_root_dir: true
  movies:
  tv:
    # <OPTIONAL> exclude_tags: torrents carrying any of these labels are skipped.
    exclude_tags:
      - manual
    # <OPTIONAL> ignore_root_dir: ignore hardlinks inside root_dir itself (default true).
    ignore_root_dir: true

orphaned:
  # Orphaned files are files under root_dir that no torrent references.
  # Files in orphaned_dir older than empty_after_x_days are deleted at the end of every run (unless skip_cleanup).
  # Leave it unset to never empty the folder. WARNING: 0 deletes orphaned files immediately instead of moving them.
  empty_after_x_days: 60
  # Files newer than this many minutes are not treated as orphans (0 disables the protection).
  min_file_age_minutes: 30
  # Files matching these patterns are never treated as orphans.
  exclude_patterns:
    - "**/.DS_Store"
    - "**/Thumbs.db"
    - "**/*.part"
  # Nothing is moved when more files than this qualify in one run (-1 disables the safeguard).
  max_orphaned_files_to_delete: 50

share_limits:
  # Each torrent is matched with the first group, in priority order, whose filters it passes, and only that one.
  # The group name can be any string. Filters use Transmission labels (there are no categories).
  # Time values are minutes or strings such as "2h30m" or "7d"; sizes are bytes or strings such as "500MB".
  noHL:
    # <MANDATORY> priority: lower numbers are matched first; must be unique.
    priority: 1
    # <OPTIONAL> include_all_tags / include_any_tags / exclude_all_tags / exclude_any_tags: label filters.
    include_all_tags:
      - noHL
    exclude_any_tags:
      - keep-seeding
    # <OPTIONAL> min_torrent_size / max_torrent_size: size filters.
    # <OPTIONAL> max_ratio: -2 Transmission's global limit, -1 no limit (default), else the ratio.
    max_ratio: 5.0
    # <OPTIONAL> max_seeding_time: -1 no limit (default). Transmission has no seeding-time limit, so a torrent
    # that has seeded this long is stopped by transmission_manage on its next run.
    max_seeding_time: 129600
    # <OPTIONAL> min_seeding_time: the torrent is protected (tag added, limits lifted) until it has seeded this
    # long. Needs max_ratio > 0.
    min_seeding_time: 43200
    # <OPTIONAL> max_last_active: limit reached after this long without activity (-1 disables it).
    max_last_active: -1
    # <OPTIONAL> min_last_active: protect the torrent until it has been inactive this long.
    min_last_active: 0
    # <OPTIONAL> min_num_seeds: protect the torrent while the swarm has fewer seeds than this.
    min_num_seeds: 0
    # <OPTIONAL> limit_upload_speed: KiB/s, -1 unlimited. enable_group_upload_speed splits it across the group.
    limit_upload_speed: -1
    enable_group_upload_speed: false
    # <OPTIONAL> upload_speed_on_limit_reached: with cleanup false, throttle to this KiB/s (-1 unlimited)
    # instead of stopping once a limit is reached. 0 disables it.
    upload_speed_on_limit_reached: 0
    # <OPTIONAL> cleanup: remove torrents that reached a limit (through the pre_remove hook). Contents shared
    # with a working torrent of the same name are kept.
    cleanup: false
    # <OPTIONAL> share_limit_action: Default or Stop. Transmission can only stop a torrent at a limit.
    share_limit_action: Default
    # <OPTIONAL> resume_torrent_after_change: resume a stopped, complete torrent after its limits change.
    resume_torrent_after_change: true
    # <OPTIONAL> add_group_to_tag: label the torrent with share_limits_tag, priority and group name.
    add_group_to_tag: true
    # <OPTIONAL> custom_tag: use this label instead of the generated one; must be unique.
    # <OPTIONAL> reset_upload_speed_on_unmet_minimums: lift the upload limit while a minimum protects the torrent.
    reset_upload_speed_on_unmet_minimums: true
  default:
    priority: 999
    max_ratio: -1
    max_seeding_time: -1

hooks:
  # Extension commands; each gets a JSON object on stdin. A hook that fails to run or exceeds the timeout counts
  # as a no. See the README for the payloads.
  # <OPTIONAL> pre_remove: run before every torrent removal; exit status 0 lets it proceed, anything else skips
  # it. On exit 0 a last stdout line of {"delete_data": false} keeps the files and removes only the torrent.
  pre_remove: null
  # <OPTIONAL> pre_remove_batch: run once per rem_unregistered run with every planned removal; exit status 0 lets
  # the run proceed, anything else skips all of its removals.
  pre_remove_batch: null
  # <OPTIONAL> classify_unregistered: run for a failing torrent whose tracker messages match none of the built-in
  # unregistered messages; exit status 0 marks it unregistered.
  classify_unregistered: null
  timeout: 60 # Seconds.

webhooks:
  # Plain http(s) URLs receiving a JSON POST. Leave empty to disable.
  error: null
  run_start: null
  run_end: null
  function:
    rem_unregistered: null
    rem_orphaned: null
    share_limits: null # Also receives cleanup_share_limits.
